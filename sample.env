# ───────────────────────────────────────────────
# roleplay — sample environment
# Copy to .env (or your deploy platform's env vars).
# NEVER commit the real .env. This file has no secrets.
# ───────────────────────────────────────────────

# REQUIRED — LLM provider bearer token.
MODEL_API_KEY=replace_me_with_your_api_key

# Optional — OpenAI-compatible provider overrides (defaults shown).
# MODEL_BASE_URL=https://inference.hetzner.com/api/v1
# MODEL_NAME=Qwen/Qwen3.6-35B-A3B-FP8

# Optional — HTTP port (default 3000).
# PORT=3000

# Optional — snapshot file for session memory (Dockerfile sets this).
# SNAPSHOT=/app/data/sessions.json