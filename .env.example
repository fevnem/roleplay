# roleplay — required & optional configuration
#
# All settings are read from the environment at process start.
# Copy this file to your shell / container env (or a .env loaded by your
# deploy platform). NEVER commit real secrets.

# ── LLM Provider ───────────────────────────────────────────────
# These four are REQUIRED — roleplay targets any OpenAI-compatible endpoint.
# They are named generically so the binary is provider-agnostic (Hetzner,
# OpenAI, OpenRouter, a local vLLM, … all work).

# Provider name (label only, used in logs). e.g. hetzner, openai, openrouter
PROVIDER_NAME=hetzner

# Model identifier to request. e.g. Qwen/Qwen3.6-35B-A3B-FP8
MODEL_NAME=Qwen/Qwen3.6-35B-A3B-FP8

# OpenAI-compatible base endpoint (no trailing /chat/completions).
# e.g. https://inference.hetzner.com/api/v1
PROVIDER_API_ENDPOINT=https://inference.hetzner.com/api/v1

# Provider bearer API key. REQUIRED.
PROVIDER_API_KEY=your-hetzner-or-openai-compatible-key

# ── Optional ───────────────────────────────────────────────────
# HTTP listen port (default 3000).
# PORT=3000

# JSON snapshot path so session memory survives a restart
# (default: pure RAM). The Dockerfile sets this to /app/data/sessions.json.
# SNAPSHOT=/app/data/sessions.json