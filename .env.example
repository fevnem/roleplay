# roleplay — required & optional configuration
#
# All settings are read from the environment at process start.
# Copy this file to your shell / container env (or a .env loaded by your
# deploy platform). NEVER commit real secrets.

# Required — the provider bearer token for the LLM API.
# (Hetzner inference is the default provider.)
MODEL_API_KEY=your-hetzner-or-openai-compatible-key

# Optional — override the provider (defaults shown).
# MODEL_BASE_URL=https://inference.hetzner.com/api/v1
# MODEL_NAME=Qwen/Qwen3.6-35B-A3B-FP8

# Optional — HTTP listen port (default 3000).
# PORT=3000

# Optional — JSON snapshot path so session memory survives a restart
# (default: pure RAM). The Dockerfile sets this to /app/data/sessions.json.
# SNAPSHOT=/app/data/sessions.json